# Copien este archivo como .env y ajusten los valores. NUNCA suban el .env a GitHub.
ENTORNO=desarrollo
DATABASE_URL=postgresql+psycopg://nimbus:nimbus@localhost:5432/nimbusvault

JWT_SECRET=genera-uno-con: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# consola = el correo sale en la terminal del backend | smtp = se envía (Mailpit en local)
EMAIL_BACKEND=consola
SMTP_HOST=localhost
SMTP_PORT=1025

COOKIE_SECURE=false
ADMIN_CORREO=admin@nimbusvault.local
ADMIN_PASSWORD=Admin12345!
