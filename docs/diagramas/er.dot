digraph ER {
  graph [fontname="DejaVu Sans", labelloc=t, fontsize=22, pad=0.4, nodesep=0.6, ranksep=0.9, label=<Modelo Entidad-Relación — NimbusVault (PostgreSQL)<BR/><FONT POINT-SIZE="11" COLOR="#64748B">Tablas con borde continuo: ya existen (migración 0001). Borde punteado: se crean en el Avance 2.</FONT><BR/> >];
  node [shape=plaintext, fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#475569", fontcolor="#334155", dir=both, penwidth=1.2];
  roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#7C4DFF" BGCOLOR="#F5F2FF"><TR><TD COLSPAN="3" BGCOLOR="#7C4DFF" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B91C1C" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id_rol</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#7C3AED" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">VARCHAR(200)</FONT></TD></TR></TABLE>>];
