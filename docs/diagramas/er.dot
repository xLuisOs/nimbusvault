  planes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#B7470B" BGCOLOR="#F9F2ED"><TR><TD COLSPAN="3" BGCOLOR="#B7470B" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="12"><B>planes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#B91C1C" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id_plan</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#7C3AED" POINT-SIZE="9"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">codigo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripcion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">VARCHAR(300)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">precio_mensual</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">NUMERIC(10,2) USD</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descuento_anual_pct</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">almacenamiento_gb</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">vigencia_dias</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">destacado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">orden</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">color</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">VARCHAR(7)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">creado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">actualizado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
