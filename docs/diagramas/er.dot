 ALIGN="LEFT"><FONT POINT-SIZE="10">actualizado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">eliminado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#475569">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
  roles -> usuarios [label="  tiene", arrowtail=teetee, arrowhead=crowodot];
  usuarios -> tokens_usuario [label="  recibe", arrowtail=teetee, arrowhead=crowodot];
  usuarios -> sesiones [label="  abre", arrowtail=teetee, arrowhead=crowodot];
  usuarios -> suscripciones [label="  contrata", arrowtail=teetee, arrowhead=crowodot];
  planes -> suscripciones [label="  define", arrowtail=teetee, arrowhead=crowodot];
  planes -> plan_caracteristicas [label="  muestra", arrowtail=teetee, arrowhead=crowodot];
  suscripciones -> pagos [label="  registra", arrowtail=teetee, arrowhead=crowodot];
  usuarios -> carpetas [label="  organiza", arrowtail=teetee, arrowhead=crowodot];
  usuarios -> archivos [label="  sube", arrowtail=teetee, arrowhead=crowodot];
  carpetas -> archivos [label="  contiene", arrowtail=teeodot, arrowhead=crowodot];
  carpetas -> carpetas [label="  subcarpeta de", arrowtail=teeodot, arrowhead=crowodot, tailport=ne, headport=se, minlen=2];
  notas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94A3B8" BGCOLOR="#F8FAFC"><TR><TD ALIGN="LEFT"><B>Reglas que no se ven en las líneas</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">• Todos los montos están en dólares (USD)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">• Los pagos son simulados: no hay cobros reales ni</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">   se guardan datos de tarjeta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">• Un usuario solo puede tener UNA suscripción activa</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">   (índice único parcial WHERE estado = 'activa')</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">• suscripciones.precio_contratado guarda lo que se pagó;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">   no cambia si el admin edita el precio del plan</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">• UQ (id_usuario, id_carpeta_padre, nombre) en carpetas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">• Tokens y refresh tokens se guardan hasheados (SHA-256)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">• CHECK en estados, precios ≥ 0, fecha_fin &gt; fecha_inicio</FONT></TD></TR></TABLE>>];
  leyenda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#94A3B8" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Leyenda</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#B91C1C"><B>PK</B></FONT></TD><TD ALIGN="LEFT">Clave primaria</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">Clave foránea</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#7C3AED"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">Valor único</TD></TR><TR><TD ALIGN="LEFT">─┼┼</TD><TD ALIGN="LEFT">Uno (1)</TD></TR><TR><TD ALIGN="LEFT">─○┼</TD><TD ALIGN="LEFT">Cero o uno (0..1)</TD></TR><TR><TD ALIGN="LEFT">─○&lt;</TD><TD ALIGN="LEFT">Cero o muchos (0..N)</TD></TR></TABLE>>];
  { rank=same; roles; planes; }
  { rank=same; notas; leyenda; }
  pagos -> notas [style=invis, dir=none]; archivos -> leyenda [style=invis, dir=none];
}